# /etc/strategy/strategy.env — environment of the systemd service (mode 640, owner root, group strategy). Never commit the real file.
# Runtime role (SELECT + INSERT only on the audit trail, ADR 0018):
ConnectionStrings__Strategy=Host=127.0.0.1;Port=5432;Database=strategy;Username=strategy_app;Password=<runtime password>
# Owner role: used only by "--migrate" / "--setup-db-roles" (run them with this variable set, see README.md). Leave it out of the
# service's file if you prefer to pass it only on the command line during upgrades.
#ConnectionStrings__StrategyMigrations=Host=127.0.0.1;Port=5432;Database=strategy;Username=strategy;Password=<owner password>
Gotenberg__Url=http://127.0.0.1:3000
Files__Provider=local
Files__LocalPath=/var/lib/strategy/files
Scheduling__TimeZone=Asia/Dubai
Spa__RootPath=/opt/strategy/app/wwwroot
# Optional: encrypt the Data Protection key ring with a certificate (keep a copy with the backups).
#DataProtection__CertificatePath=/etc/strategy/dataprotection.pfx
#DataProtection__CertificatePassword=<password>
# Behind the nginx reverse proxy on the same host (deploy/nginx/strategy.conf):
ForwardedHeaders__Enabled=true
ForwardedHeaders__KnownProxies__0=127.0.0.1
Mcp__RequireHttps=true
# Tesseract OCR is found on the PATH (apt package tesseract-ocr); otherwise:
#Ocr__TesseractPath=/usr/bin/tesseract
