# Copy to deploy/.env and adjust. Never commit the real .env.

# Database
POSTGRES_DB=strategy
POSTGRES_USER=strategy
POSTGRES_PASSWORD=change-me
# Published on the loopback interface only (development, local tools); the application uses the internal network.
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1
# Runtime role the application connects as (ADR 0018): created by deploy/postgres/init-roles.sh on the first start of an empty volume;
# it may only read and append to the audit trail. Existing installs: create it by hand (see deploy/README.md) or keep the owner role.
STRATEGY_APP_USER=strategy_app
STRATEGY_APP_PASSWORD=change-me-too

# Application (profile "app")
# The only port reachable from the network. APP_BIND=127.0.0.1 when a reverse proxy on this host is the only entry.
APP_PORT=8080
APP_BIND=0.0.0.0
# Image tag strategy-app:<version>; set by install.sh / upgrade.sh from deploy/VERSION.
APP_VERSION=1.0.0
ASPNETCORE_ENVIRONMENT=Production
# The template module is for development only.
MODULE_SAMPLE_ENABLED=false
# Portfolio Management (Phase 8): first state at installation; afterwards Settings → Systems decides.
MODULE_PORTFOLIO_ENABLED=true
MODULE_WASEL_ENABLED=true

# Data Protection (ADR 0012): keys live in the database. To also encrypt them at rest, mount a PKCS#12 certificate
# into the app container (see README) and give its path inside the container and its password.
DATAPROTECTION_CERTIFICATE_PATH=
DATAPROTECTION_CERTIFICATE_PASSWORD=

# Files: local volume (default) or S3-compatible storage (MinIO, AWS S3)
FILES_PROVIDER=local
FILES_S3_SERVICE_URL=
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=

# Scheduled jobs run in this time zone (IANA id)
SCHEDULING_TIME_ZONE=Asia/Dubai

# Sidecars
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_PORT=3000
GOTENBERG_BIND=127.0.0.1
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MEILI_MASTER_KEY=change-me-to-a-long-random-key

# Observability: set to export traces and metrics over OTLP (e.g. http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Pull Docker Hub images through a mirror in restricted networks, e.g. mirror.gcr.io/
REGISTRY_PREFIX=
# Behind a TLS-inspecting proxy: path to the organisation's CA bundle (PEM), used only during the image build.
BUILD_CA_FILE=

# Container logs (json-file rotation) and the size of the app's tmpfs /tmp (read-only root file system)
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
APP_TMP_SIZE=512m

# Security (ADR 0155): behind the HTTPS reverse proxy set SECURE_COOKIES=true (cookies only over HTTPS).
SECURE_COOKIES=false
# Outbound calls to admin-entered URLs (AI provider, identity providers) may reach private networks (typical on-prem). Set false when
# every provider is on the Internet; loopback and link-local (cloud metadata) addresses are always refused.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=true

# Image build: Tesseract OCR for scanned documents (ADR 0033). false = image without the OCR packages, including the GPL-2+ library
# libjbig0 (notices: /app/licenses/ocr/ in the image, docs/THIRD_PARTY_LICENSES.md). Takes effect on the next build (install / upgrade).
INSTALL_OCR=true

# Image build on a slow or unreliable network (ADR 0163). Defaults shown; uncomment to change. Takes effect on the next build.
# npm: attempts per package, back-off between attempts and the time one request may take (milliseconds)
#NPM_FETCH_RETRIES=5
#NPM_FETCH_RETRY_MINTIMEOUT=20000
#NPM_FETCH_RETRY_MAXTIMEOUT=120000
#NPM_FETCH_TIMEOUT=600000
# NuGet: per-request attempts and delay (ms); whole "dotnet restore" attempts; true = no parallel restore (fewer connections)
#NUGET_ENHANCED_MAX_NETWORK_TRY_COUNT=10
#NUGET_ENHANCED_NETWORK_RETRY_DELAY_MILLISECONDS=3000
#NUGET_RESTORE_ATTEMPTS=3
#NUGET_RESTORE_DISABLE_PARALLEL=false
# apt (runtime image): attempts per download and request timeout (seconds)
#APT_RETRIES=5
#APT_HTTP_TIMEOUT=120
