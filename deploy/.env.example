# Copy to deploy/.env and adjust. Never commit the real .env.

# Database
POSTGRES_DB=strategy
POSTGRES_USER=strategy
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Application (profile "app")
APP_PORT=8080
APP_VERSION=dev
ASPNETCORE_ENVIRONMENT=Production
# The template module is for development only.
MODULE_SAMPLE_ENABLED=false

# Sidecars
GOTENBERG_PORT=3000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MEILI_MASTER_KEY=change-me-to-a-long-random-key

# Observability: set to export traces and metrics over OTLP (e.g. http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Pull Docker Hub images through a mirror in restricted networks, e.g. mirror.gcr.io/
REGISTRY_PREFIX=
# Behind a TLS-inspecting proxy: path to the organisation's CA bundle (PEM), used only during the image build.
BUILD_CA_FILE=
