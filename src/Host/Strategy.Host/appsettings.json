{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Strategy": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Modules": {
    "Sample": { "Enabled": false }
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "Spa": {
    "RootPath": "wwwroot"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } }
    ]
  }
}
