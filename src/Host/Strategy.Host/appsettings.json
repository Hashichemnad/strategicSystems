{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Strategy": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Files": {
    "Provider": "local",
    "LocalPath": "data/files"
  },
  "Gotenberg": {
    "Url": ""
  },
  "Modules": {
    "Sample": { "Enabled": false },
    "Portfolio": { "Enabled": true },
    "Wasel": { "Enabled": true },
    "Kpi": { "Enabled": true },
    "Risk": { "Enabled": true },
    "Cap": { "Enabled": true },
    "Bench": { "Enabled": true },
    "Requests": { "Enabled": true },
    "DocReg": { "Enabled": true },
    "Ip": { "Enabled": true }
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "Spa": {
    "RootPath": "wwwroot"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } }
    ]
  }
}
