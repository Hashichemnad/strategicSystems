<Project Sdk="Microsoft.NET.Sdk">
  <!-- Users, sign-in (local, MFA, OIDC, SAML, LDAP), sessions, personal access tokens (SPEC §0, docs/design/identity.md). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Strategy.Platform.Kernel\Strategy.Platform.Kernel.csproj" />
    <ProjectReference Include="..\Strategy.Platform.Persistence\Strategy.Platform.Persistence.csproj" />
    <ProjectReference Include="..\Strategy.Platform.Access\Strategy.Platform.Access.csproj" />
    <ProjectReference Include="..\Strategy.Platform.Http\Strategy.Platform.Http.csproj" />
    <ProjectReference Include="..\Strategy.Platform.Organisation\Strategy.Platform.Organisation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Sustainsys.Saml2.AspNetCore2" />
    <PackageReference Include="System.DirectoryServices.Protocols" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!--
      Sustainsys.Saml2 2.11 asks for Microsoft.IdentityModel.Tokens.Saml >= 5.2.4 and ConfigurationManager >= 4.4.1, whose
      netstandard1.x chain (NETStandard.Library 1.6.1) carries the non-OSI .NET Library licence. Current MIT versions,
      aligned with the IdentityModel 8.x the OIDC handler already uses (CLAUDE.md §4.3).
    -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens.Saml" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Email\Templates\*.html" />
    <EmbeddedResource Include="Email\Templates\*.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Strategy.UnitTests" />
    <InternalsVisibleTo Include="Strategy.IntegrationTests" />
    <InternalsVisibleTo Include="Strategy.Host" />
  </ItemGroup>
</Project>
