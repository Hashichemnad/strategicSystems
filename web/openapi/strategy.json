          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        },
        "description": "The token the SPA sends back in string AntiforgerySetup.HeaderName on every state-changing call."
      },
      "PagedResultOfSampleItemDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SampleItemDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "One page of items plus the total count across all pages."
      },
      "Problem": {
